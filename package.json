{
  "name": "custom-connector-guide",
  "private": true,
  "packageManager": "^npm@11.10.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11.10.0"
  },
  "workspaces": [
    "sources/*",
    "destinations/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "fix": "turbo run fix",
    "lint": "turbo run lint",
    "prepare": "husky install",
    "test": "turbo run test",
    "test-cov": "turbo run test-cov"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "faros-js-client": "^0.8.8"
  },
  "devDependencies": {
    "@types/commander": "^2.12.0",
    "turbo": "^2.1.1",
    "@types/jest": "^29.5.10",
    "@types/node": "^24.1.0",
    "@types/verror": "^1.10.11",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "husky": "^8.0.1",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.4.5"
  }
}
